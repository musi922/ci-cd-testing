{
  "name": "ewe",
  "version": "1.0.0",
  "description": "CAP Service",
  "repository": "tbd later",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^4.7.0",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^8.9.10",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.4",
    "@sap/cds-dk": "^8",
    "@sap/eslint-plugin-cds": "^3.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-yml": "^3.4.0",
    "globals": "^17.6.0"
  },
"scripts": {
  "start": "cds-serve",
  "watch": "cds watch",
  "build": "mbt build",
  "lint": "eslint .",
  "deploy": "cf deploy mta_archives/*.mtar -f"
},
  "engines": {
    "node": ">=20"
  },
  "cds": {
    "requires": {
      "SUE_S4H": {
        "kind": "odata-v4",
        "model": "srv/external/SUE_S4H",
        "credentials": {
          "destination": "SUE",
          "path": "/sap/opu/odata/sap/CDSALLVIEWS/"
        }
      },
      "db": {
        "kind": "sql"
      },
      "[production]": {
        "db": {
          "kind": "hana",
          "deploy-format": "hdbtable"
        }
      }
    }
  }
}
